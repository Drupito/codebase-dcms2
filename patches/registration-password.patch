+
+/**
+ * Enhances the password field with additional security features.
+ */
+function _drupito_enhance_password_security(array &$form): void {
+  $form['admin_account']['account']['pass']['#attributes']['minlength'] = 12;
+  $form['admin_account']['account']['pass']['#attributes']['autocomplete'] = 'new-password';
+  $form['admin_account']['account']['pass']['#description'] = t('Password must be at least 12 characters long and include both letters and numbers.');
+  $form['admin_account']['account']['pass']['#element_validate'][] = '_drupito_password_strength_validate';
+}
+
+/**
+ * Validates password strength.
+ */
+function _drupito_password_strength_validate(array &$element, \Drupal\Core\Form\FormStateInterface $form_state): void {
+  $password = (string) $element['#value'];
+  if (strlen($password) < 12) {
+    $form_state->setError($element, t('Password must be at least 12 characters long.'));
+  }
+  if (!preg_match('/[0-9]/', $password) || !preg_match('/[a-zA-Z]/', $password)) {
+    $form_state->setError($element, t('Password must include both letters and numbers.'));
+  }
+  $email = (string) $form_state->getValue(['account', 'mail']);
+  if ($email !== '' && str_contains($password, $email)) {
+    $form_state->setError($element, t('Password must not contain your email address.'));
+  }
+}
