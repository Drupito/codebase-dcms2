{% set style = icon_style | default('circle') %}

{# Resolve icon colour to a CSS value #}
{% set color_map = {
  'accent':      'var(--color-accent)',
  'primary-mid': 'var(--color-primary-mid)',
  'primary':     'var(--color-primary)',
  'white':       '#ffffff',
} %}
{% set resolved_color = icon_color == 'custom'
  ? icon_color_custom | default('var(--color-primary-mid)')
  : color_map[icon_color | default('primary-mid')] | default('var(--color-primary-mid)') %}

<div class="dst-contact-info">

  {% if heading %}
    <h3 class="dst-contact-info__heading">{{ heading }}</h3>
  {% endif %}

  <ul class="dst-contact-info__list">

    {% if phone %}
      <li class="dst-contact-info__item">
        <span class="dst-contact-info__icon dst-contact-info__icon--{{ style }}" style="--ci-color: {{ resolved_color }}" aria-hidden="true">
          {# Phone icon #}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.72 6.72l1.79-1.79a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.03z"/>
          </svg>
        </span>
        <a class="dst-contact-info__text" href="tel:{{ phone | replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ phone }}</a>
      </li>
    {% endif %}

    {% if email %}
      <li class="dst-contact-info__item">
        <span class="dst-contact-info__icon dst-contact-info__icon--{{ style }}" style="--ci-color: {{ resolved_color }}" aria-hidden="true">
          {# Email icon #}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </span>
        <a class="dst-contact-info__text" href="mailto:{{ email }}">{{ email }}</a>
      </li>
    {% endif %}

    {% if hours %}
      <li class="dst-contact-info__item">
        <span class="dst-contact-info__icon dst-contact-info__icon--{{ style }}" style="--ci-color: {{ resolved_color }}" aria-hidden="true">
          {# Clock icon #}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </span>
        <span class="dst-contact-info__text">{{ hours }}</span>
      </li>
    {% endif %}

    {% if address %}
      <li class="dst-contact-info__item">
        <span class="dst-contact-info__icon dst-contact-info__icon--{{ style }}" style="--ci-color: {{ resolved_color }}" aria-hidden="true">
          {# Location pin icon #}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <span class="dst-contact-info__text">{{ address }}</span>
      </li>
    {% endif %}

  </ul>
</div>
