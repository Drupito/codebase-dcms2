{% set decoration = decoration ?: 'none' %}
{% set img_shape = shape | default('default') %}
{% set custom_radius = border_radius|default(0) %}
{% set has_custom_radius = custom_radius > 0 %}
{% set has_radius = has_custom_radius or (radius is not empty) ? 'yes' : 'no' %}
{% set has_url = url is not empty ? 'yes' : 'no' %}
{% set mw = max_width | default(0) %}

{# Shape overrides size + radius #}
{% if img_shape == 'circle' %}
  {% set container_classes = 'cq-full w-full aspect-1/1 overflow-hidden dst-image--circle' %}
  {% set container_style = '' %}
{% elseif img_shape == 'arch' %}
  {% set container_classes = 'cq-full w-full overflow-hidden dst-image--arch' %}
  {% set container_style = '' %}
{% else %}
  {% set image_container =
    html_cva(
      base: 'cq-full w-full',
      variants: {
        size: {
          '2:1': 'aspect-2/1',
          '16:9': 'aspect-16/9',
          '3:2': 'aspect-3/2',
          '4:3': 'aspect-4/3',
          '1:1': 'aspect-1/1'
        },
        hasRadius: {
          yes: 'overflow-hidden',
          no: 'rounded-none'
        },
        radius: {
          small: 'rounded-sm',
          large: 'rounded-xl md:rounded-2xl',
          'extra-large': 'rounded-[24px] md:rounded-[32px]'
        }
      }
    )
  %}
  {% set container_classes =
    image_container.apply({
      size: size,
      hasRadius: has_radius,
      radius: has_custom_radius ? '' : radius
    })
  %}
  {% set container_style = has_custom_radius ? 'border-radius: ' ~ custom_radius ~ 'px' : '' %}
{% endif %}

{% set has_badge = badge_text is not empty %}

{% if decoration != 'none' %}<div class="dst-image-wrap dst-image-wrap--{{ decoration }}">{% endif %}
{% if mw > 0 %}<div style="max-width:{{ mw }}px;width:100%;margin-inline:auto;">{% endif %}
<figure{{ has_badge ? ' class="dst-image-has-badge"' : '' }}>
  <div class="{{ container_classes }}"{% if container_style %} style="{{ container_style }}"{% endif %}>
    {% block media %}
    {% if media.src is not empty %}
      {% if url is not empty %}
        <a href="{{ url }}" class="group">
          {% include 'canvas:image' ignore missing with {
            src: media.src,
            alt: media.alt,
            class: 'object-cover w-full h-full group-hover:scale-105 duration-300',
            width: media.width,
            height: media.height,
            loading: 'eager'
          } only %}
        </a>
      {% else %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'object-cover w-full h-full',
          width: media.width,
          height: media.height
        } only %}
      {% endif %}
    {% endif %}
    {% endblock %}
  </div>
  {% if has_badge %}
    <div class="dst-image-badge dst-image-badge--{{ badge_position|default('bottom-right') }}">
      {% if badge_icon.src %}
        <img src="{{ badge_icon.src }}" alt="{{ badge_icon.alt|default('') }}" class="dst-image-badge__icon">
      {% endif %}
      <p class="dst-image-badge__text">{{ badge_text }}</p>
    </div>
  {% endif %}

  {% if caption %}
    <figcaption class="block py-1 text-sm lg:py-2 lg:text-base">
      {{ caption }}
    </figcaption>
  {% endif %}
</figure>
{% if mw > 0 %}</div>{% endif %}
{% if decoration != 'none' %}</div>{% endif %}
