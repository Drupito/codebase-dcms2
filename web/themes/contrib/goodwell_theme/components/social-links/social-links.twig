{% set style = style ?: 'circle' %}
{% set size  = size  ?: 'md' %}
{% set color = color ?: 'default' %}

{# Build list of active platforms #}
{% set platforms = [] %}

{% if facebook_url %}
  {% set platforms = platforms|merge([{
    id:    'facebook',
    label: 'Facebook',
    url:   facebook_url,
    icon:  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>'
  }]) %}
{% endif %}

{% if instagram_url %}
  {% set platforms = platforms|merge([{
    id:    'instagram',
    label: 'Instagram',
    url:   instagram_url,
    icon:  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>'
  }]) %}
{% endif %}

{% if twitter_url %}
  {% set platforms = platforms|merge([{
    id:    'twitter',
    label: 'X (Twitter)',
    url:   twitter_url,
    icon:  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>'
  }]) %}
{% endif %}

{% if linkedin_url %}
  {% set platforms = platforms|merge([{
    id:    'linkedin',
    label: 'LinkedIn',
    url:   linkedin_url,
    icon:  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>'
  }]) %}
{% endif %}

{% if youtube_url %}
  {% set platforms = platforms|merge([{
    id:    'youtube',
    label: 'YouTube',
    url:   youtube_url,
    icon:  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/></svg>'
  }]) %}
{% endif %}

{% if platforms|length > 0 %}
  <ul class="social-links social-links--{{ style }} social-links--{{ size }} social-links--{{ color }}" role="list">
    {% for platform in platforms %}
      <li class="social-links__item">
        <a
          href="{{ platform.url }}"
          class="social-links__link social-links__link--{{ platform.id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ platform.label }}"
        >
          {{ platform.icon|raw }}
        </a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
