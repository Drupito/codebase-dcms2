{#
/**
 * @file
 * Blog post detail page — matches Figma node 328-3972.
 *
 * Variables:
 * - node:          The blog node entity.
 * - label:         Node title.
 * - content:       Rendered fields (body, field_hero_image, etc.)
 * - related_blogs: Array of rendered teaser nodes (from preprocess).
 */
#}
{{ attach_library('hourglass/blog-detail') }}

{% set pub_date = node.field_published_date.value %}
{% set display_date = pub_date ? pub_date|date('d.m.Y') : node.createdtime|date('d.m.Y') %}
{% set read_time = node.field_read_time.value %}
{% set author_name = node.getOwner().getDisplayName() %}
{% set youtube_url  = node.field_youtube_url.uri  ?: 'https://www.youtube.com/' %}
{% set linkedin_url = node.field_linkedin_url.uri ?: 'https://www.linkedin.com' %}
{% set twitter_url  = node.field_twitter_url.uri  ?: 'https://x.com/' %}

<article class="c-blog-detail" data-nid="{{ node.id() }}">

  {# ── Hero ─────────────────────────────────────────────────────────────── #}
  <div class="c-blog-detail__hero">

    {% if node.field_hero_image.entity %}
      <div class="c-blog-detail__hero-image">
        {{ content.field_hero_image }}
      </div>
    {% endif %}

    <div class="c-blog-detail__hero-scrim" aria-hidden="true"></div>

    <div class="c-blog-detail__hero-content">

      <h1 class="c-blog-detail__title">{{ label }}</h1>

      <p class="c-blog-detail__hero-meta">
        Published {{ display_date }}{% if author_name %}  |  {{ author_name }}{% endif %}
      </p>

    </div>
  </div>

  {# ── Content: sidebar + body ──────────────────────────────────────────── #}
  <div class="c-blog-detail__content">

    <aside class="c-blog-detail__sidebar" aria-label="Article sidebar">

      <div class="c-blog-detail__toc js-blog-toc">
        <p class="c-blog-detail__toc-heading">In this article</p>
        <nav class="c-blog-detail__toc-nav" aria-label="Table of contents">
          {# Populated by JS from body h2/h4 elements #}
        </nav>
      </div>

      <div class="c-blog-detail__sidebar-social">
        <p class="c-blog-detail__sidebar-social-label">Share</p>
        <div class="c-blog-detail__sidebar-social-icons">
          <a href="{{ linkedin_url }}" class="c-blog-detail__sidebar-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="currentColor"/>
            </svg>
          </a>
          <a href="{{ twitter_url }}" class="c-blog-detail__sidebar-social-link" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.73-8.835L1.254 2.25H8.08l4.26 5.632 5.903-5.632Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" fill="currentColor"/>
            </svg>
          </a>
          <a href="{{ youtube_url }}" class="c-blog-detail__sidebar-social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
            </svg>
          </a>
        </div>
      </div>

    </aside>

    <div class="c-blog-detail__body js-blog-body">
      {% set body_summary = node.body[0].summary %}
      {% if body_summary %}
        <p class="c-blog-detail__summary">{{ body_summary }}</p>
      {% endif %}
      {% if node.body.processed %}
        <div class="text-formatted">{{ node.body.processed }}</div>
      {% endif %}
    </div>

  </div>

  {# ── More Blogs ───────────────────────────────────────────────────────── #}
  {% if related_blogs is not empty %}
    <div class="c-blog-detail__more">
      <div class="c-blog-detail__more-header">
        <h2 class="c-blog-detail__more-title">More Blogs</h2>
      </div>
      <div class="c-blog-detail__more-grid">
        {% for related in related_blogs %}
          {{ related }}
        {% endfor %}
      </div>
    </div>
  {% endif %}

</article>
