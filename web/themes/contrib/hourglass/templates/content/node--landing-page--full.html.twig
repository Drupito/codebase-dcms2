{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-' ~ view_mode|clean_class,
    'c-landing-page',
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  
  <div class="c-landing-page__content">
    {{ content }}
  </div>
  {% if node.field_floating_cta is not empty %}
    <div class="c-product-hero__cta-fixed">
      {% for item in node.field_floating_cta %}
        <a href="{{ item.url }}" class="c-button--icon-left c-product-hero__cta--fixed">
          <span class="c-button__icon">
            <span data-component-id="hourglass:icon" class="c-heading text-h2 c-heading--h1-large c-text content c-icon" style="--icon-color: white;">
