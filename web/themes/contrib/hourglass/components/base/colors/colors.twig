{#
/**
 * @file
 * Template for the Colors component.
 *
 * Available variables:
 * - extra_classes: Additional CSS classes.
 * - attributes: Drupal attributes.
 *
 * Available blocks:
 * - content: Color swatch content.
 */
#}
<div {{ attributes.addClass('c-colors', extra_classes) }}>
  {% block content %}{% endblock %}
</div>
