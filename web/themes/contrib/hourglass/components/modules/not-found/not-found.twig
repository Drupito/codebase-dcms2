{#
/**
 * @file
 * Template for the Not Found (404) module.
 *
 * Props:
 * - error_code: Large display number (default: "404").
 * - message: Descriptive text below the error code.
 * - back_label: Label for the "Go Back" button (default: "Go Back").
 * - home_label: Label for the homepage button (default: "Return to Homepage").
 * - home_url: URL for the homepage button (default: "/").
 */
#}
{{ attach_library('hourglass/not-found') }}

<div class="c-not-found {{ extra_classes|default('') }}">

  <div class="c-not-found__text">
    <p class="c-not-found__code">{{ error_code|default('404') }}</p>
    {% if message %}
      <p class="c-not-found__message">{{ message }}</p>
    {% endif %}
  </div>

  <div class="c-not-found__actions">
    <button class="c-not-found__btn-back js-not-found-back" type="button">
      {{ back_label|default('Go Back') }}
    </button>
    <a href="{{ home_url|default('/') }}" class="c-not-found__btn-home">
      {{ home_label|default('Return to Homepage') }}
    </a>
  </div>

</div>
