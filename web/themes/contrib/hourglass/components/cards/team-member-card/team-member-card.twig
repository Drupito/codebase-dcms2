{#
/**
 * @file
 * Template for the Team Member Card atom.
 *
 * Props:
 * - media: Canvas image (square photo).
 * - name: Full name.
 * - role: Job title.
 * - phone: Phone number text.
 * - phone_url: tel: href.
 * - email: Email address text.
 * - email_url: mailto: href.
 * - linkedin_url: LinkedIn profile URL.
 */
#}
{{ attach_library('hourglass/team-member-card') }}

<div class="c-team-member-card {{ extra_classes|default('') }}">

  {# ── Photo + hover overlay ─────────────────────────────────────── #}
  <div class="c-team-member-card__photo">

    {% if media %}
      {% include 'hourglass:media' with { image: media, extra_classes: 'c-team-member-card__media' } %}
    {% endif %}

    {% if email_url or linkedin_url %}
      <div class="c-team-member-card__overlay" aria-hidden="true">
        <div class="c-team-member-card__social">
          {% if email_url %}
            <a href="{{ email_url }}" class="c-team-member-card__social-btn" tabindex="-1">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          {% endif %}
          {% if linkedin_url %}
            <a href="{{ linkedin_url }}" class="c-team-member-card__social-btn" tabindex="-1" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.25 8.5H4.75V24H.25V8.5zm7.5 0H12v2.16h.06c.64-1.2 2.2-2.46 4.52-2.46C21.36 8.2 22 11.18 22 15.2V24h-4.5v-7.8c0-1.86-.03-4.26-2.6-4.26-2.6 0-3 2.03-3 4.12V24h-4.5V8.5z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>

  {# ── Info block ────────────────────────────────────────────────── #}
  <div class="c-team-member-card__info">

    {% if name %}
      <p class="c-team-member-card__name">{{ name }}</p>
    {% endif %}

    {% if role %}
      <p class="c-team-member-card__role">{{ role }}</p>
    {% endif %}

    {% if phone %}
      <div class="c-team-member-card__contact">
        <span class="c-team-member-card__contact-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <g clip-path="url(#clip0_330_7439)">
              <path d="M18.3333 14.0999V16.5999C18.3343 16.832 18.2867 17.0617 18.1937 17.2744C18.1008 17.487 17.9644 17.6779 17.7934 17.8348C17.6224 17.9917 17.4205 18.1112 17.2006 18.1855C16.9808 18.2599 16.7478 18.2875 16.5167 18.2666C13.9523 17.988 11.4892 17.1117 9.32498 15.7083C7.31151 14.4288 5.60443 12.7217 4.32499 10.7083C2.91663 8.53426 2.04019 6.05908 1.76665 3.48325C1.74583 3.25281 1.77321 3.02055 1.84707 2.80127C1.92092 2.58199 2.03963 2.38049 2.19562 2.2096C2.35162 2.03871 2.54149 1.90218 2.75314 1.80869C2.9648 1.7152 3.1936 1.6668 3.42499 1.66658H5.92499C6.32941 1.6626 6.72148 1.80582 7.02812 2.06953C7.33476 2.33324 7.53505 2.69946 7.59165 3.09992C7.69717 3.89997 7.89286 4.68552 8.17499 5.44158C8.2871 5.73985 8.31137 6.06401 8.24491 6.37565C8.17844 6.68729 8.02404 6.97334 7.79998 7.19992L6.74165 8.25825C7.92795 10.3445 9.65536 12.072 11.7417 13.2583L12.8 12.1999C13.0266 11.9759 13.3126 11.8215 13.6243 11.755C13.9359 11.6885 14.26 11.7128 14.5583 11.8249C15.3144 12.107 16.0999 12.3027 16.9 12.4083C17.3048 12.4654 17.6745 12.6693 17.9388 12.9812C18.203 13.2931 18.3435 13.6912 18.3333 14.0999Z" stroke="#F76707" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
            <defs>
              <clipPath id="clip0_330_7439">
                <rect width="20" height="20" fill="white"/>
              </clipPath>
            </defs>
          </svg>
        </span>
        {% if phone_url %}
          <a href="{{ phone_url }}" class="c-team-member-card__contact-text">{{ phone }}</a>
        {% else %}
          <span class="c-team-member-card__contact-text">{{ phone }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% if email %}
      <div class="c-team-member-card__contact">
        <span class="c-team-member-card__contact-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M2 6l8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        {% if email_url %}
          <a href="{{ email_url }}" class="c-team-member-card__contact-text">{{ email }}</a>
        {% else %}
          <span class="c-team-member-card__contact-text">{{ email }}</span>
        {% endif %}
      </div>
    {% endif %}

  </div>

</div>
