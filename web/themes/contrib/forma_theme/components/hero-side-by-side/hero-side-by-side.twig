{% set hero =
  html_cva(
    base: ['relative', 'h-full', 'flex', 'flex-col rounded-2xl bg-white'],
    variants: {
      imagePosition: {
        left: 'md:flex-row',
        right: 'md:flex-row-reverse'
      }
    }
  )
%}

{% set image_container =
  html_cva(
    base: ['flex-1 overflow-hidden'],
    variants: {
      imagePosition: {
        left: 'md:flex-row',
        right: 'md:flex-row-reverse'
      },
      imageSize: {
        '2:1': 'aspect-2/1',
        '16:9': 'aspect-16/9',
        '3:2': 'aspect-3/2',
        '4:3': 'aspect-4/3',
        '1:1': 'aspect-1/1',
        '3:4': 'aspect-3/4',
        '2:3': 'aspect-2/3'
      }
    }
  )
%}

{% set image =
  html_cva(
    base: ['h-full w-full rounded-t-xl object-cover md:rounded-none'],
    variants: {
      imagePosition: {
        left: 'md:rounded-l-xl',
        right: 'md:rounded-r-xl'
      }
    }
  )
%}

{% set content =
  html_cva(
    base: ['flex-1', 'overflow-hidden'],
    variants: {
      justifyContent: {
        start: 'justify-start',
        center: 'justify-center',
        end: 'justify-end'
      }
    }
  )
%}

{% set hero_classes =
  hero.apply({
    imagePosition: image_position
  })
%}

{% set image_container_classes =
  image_container.apply({
    imageSize: image_size|default('4:3')
  })
%}

{% set content_classes =
  content.apply({
    justifyContent: justify_content
  })
%}

<section class="{{ hero_classes }}">
  <div class="{{ image_container_classes }}">
    {% block hero_media %}
      {% if media is not empty and media.src is not empty %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: image.apply({
            imagePosition: image_position
          }),
          width: media.width,
          height: media.height,
          loading: 'eager',
          sizes: '50vw'
        } only %}
      {% endif %}
    {% endblock %}
  </div>
  <div class="{{ content_classes }} flex flex-1 flex-col gap-2 md:gap-4">
    <div class="p-12 md:p-20">
      {% block hero_content %}
        {% block hero_slot %}

        {% endblock %}
      {% endblock %}
    </div>
  </div>
</section>
