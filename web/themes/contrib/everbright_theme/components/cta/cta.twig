{% set background_color = background_color|default('noColor') %}
{% set eyebrow_text_color = background_color == 'primary' ? 'inverted' : 'default' %}
{% set cta_text_color = background_color == 'primary' ? 'inverted' : 'default' %}

{% set cta_variants =
  html_cva(
    base: ['cq-full relative z-1'],
    variants: {
      backgroundColor: {
        primary: 'bg-primary text-primary-foreground',
        noColor: 'bg-none text-foreground',
        muted: 'bg-muted text-foreground'
      }
    }
  )
%}

{% set cta_content_variants =
  html_cva(
    base: [
      'relative',
      'lg:max-w-3/4',
      'mx-auto',
      'items-center',
      'flex flex-col justify-center',
      'min-h-80',
      'gap-6 lg:gap-8',
      'py-[90px] lg:py-[115px] xl:py-[140px]'
    ]
  )
%}

{% set cta_links_variants =
  html_cva(
    base: ['flex flex-col', 'gap-6', 'border-t', 'max-w-4xl', 'pt-12'],
    variants: {
      backgroundColor: {
        primary: 'border-background',
        noColor: 'border-foreground'
      }
    }
  )
%}

<section
  class="{{
  cta_variants.apply({
    backgroundColor: background_color
  })
  }}"
>
  {% block media %}
    {% if media.src is not empty %}
      <div class="absolute z-[-1] h-full w-full">
        <div class="absolute inset-0 bg-black/30"></div>
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'object-cover w-full h-full',
          width: media.width,
          height: media.height
        } only %}
      </div>
    {% endif %}
  {% endblock %}
  <div class="{{ cta_content_variants.apply({}) }} px-4">
    <div class="flex flex-col justify-center gap-8 pb-8 text-center">
      {{
        include(
          'everbright_theme:eyebrow',
          {
            eyebrow_text: eyebrow_text|default(''),
            text_color: eyebrow_text_color|default('default')
          },
          with_context: false
        )
      }}

      {% if heading is not empty %}
        <div
          class="mx-auto max-w-4xl [&_h1]:font-semibold [&_h2]:font-semibold [&_h3]:font-semibold [&_h4]:font-semibold [&_h5]:font-semibold [&_h6]:font-semibold"
        >
          {% block heading %}
            {{
              include(
                'everbright_theme:text',
                {
                  text: heading,
                  text_color: cta_text_color,
                  text_size: 'text-6xl'
                },
                with_context: false
              )
            }}
          {% endblock %}
        </div>
      {% endif %}

      {% if text is not empty %}
        <div class="mx-auto max-w-2xl">
          {% block text %}
            {{
              include(
                'everbright_theme:text',
                {
                  text: text,
                  text_color: cta_text_color,
                  text_size: 'text-xl'
                },
                with_context: false
              )
            }}
          {% endblock %}
        </div>
      {% endif %}
    </div>
    {% if block('actions') is defined %}
      <div
        class="{{
        cta_links_variants.apply({
          backgroundColor: background_color
        })
        }}"
      >
        {% block actions %}

        {% endblock %}
      </div>
    {% endif %}
  </div>
</section>
