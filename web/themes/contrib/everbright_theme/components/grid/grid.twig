{% set section =
  html_cva(
    base: ['relative flex flex-col items-stretch'],
    variants: {
      width: {
        '100%': 'lg:max-w-full',
        '90%': 'lg:max-w-9/10',
        '80%': 'lg:max-w-8/10',
        '70%': 'lg:max-w-7/10',
        '60%': 'lg:max-w-6/10',
        '50%': 'lg:max-w-1/2'
      },
      align: {
        center: 'mx-auto',
        left: 'mr-auto',
        right: 'ml-auto'
      }
    }
  )
%}

{% set grid_content =
  section.apply({
    width: width|default('100%'),
    align: align|default('center')
  })
%}

{# the first character of the columns variable, which *should* be a number #}
{% set cols_variable = columns|first %}
{% set grid_attributes =
  create_attribute({
    class: ['[--gap:calc(var(--cols)*1cqw)]']
  }).setAttribute(
    'style',
    '--cols:' ~ cols_variable
  )
%}
{% set grid_class = use_flex_uneven_items ? 'flex flex-wrap justify-center md:flex-row' : 'grid w-full min-w-0 @sm:gap-2 @md:gap-4 @3xl:gap-6' %}
{% if use_flex_uneven_items == true and cols_variable matches '/^\\d+$/' %}
  {#
    uses the number of configured columns and the gap variable multiplied by (configured columns - 1)
    and applies this to the flex-basis property of each descendant
  #}
  {% set grid_attributes = grid_attributes.addClass('md:[&>*]:basis-[calc(calc(100%-calc(var(--gap)*calc(var(--cols)-1)))/var(--cols))]') %}
{% endif %}

{% set grid =
  html_cva(
    base: [grid_class, 'w-full min-w-0', 'gap-(--gap)'],
    variants: {
      columns: {
        '1 column': 'grid-cols-1',
        '2 columns': 'md:grid-cols-2',
        '3 columns': 'md:grid-cols-3',
        '4 columns': 'sm:grid-cols-2 lg:grid-cols-4',
        '5 columns': 'sm:grid-cols-2 lg:grid-cols-5',
        '6 columns': 'sm:grid-cols-3 lg:grid-cols-6',
        '2 columns 75%-25%': 'md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]',
        '2 columns 25%-75%': 'md:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]',
        '2 columns 67%-33%': 'md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]',
        '2 columns 33%-67%': 'md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]',
        '2 columns 60-40': 'md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]',
        '2 columns 40-60': 'md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]',
        '3 columns 50%-25%-25%': 'md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]',
        '3 columns 25%-25%-50%': 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,2fr)]'
      },
      mobileColumns: {
        '1': '',
        '2': 'grid-cols-2',
        '3': 'grid-cols-3'
      }
    },
    compound_variants: [
      {
        columns: ['4 columns'],
        mobileColumns: ['2'],
        class: 'sm:grid-cols-4'
      }
    ]
  )
%}

{% set grid_classes =
  grid.apply({
    columns: columns|default('100'),
    mobileColumns: mobile_columns|default('1')
  })
%}

<section>
  <div class="{{ grid_content }}">
    <div {{ grid_attributes.addClass(grid_classes) }}>
      {% block main_slot %}

      {% endblock %}
    </div>
  </div>
</section>
